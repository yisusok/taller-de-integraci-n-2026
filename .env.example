# =====================================================
# Base de Datos (PostgreSQL)
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db

# =====================================================
# Backend (NestJS)
# =====================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# =====================================================
# JWT (JSON Web Tokens - Control de Acceso y Middleware)
# =====================================================
JWT_SECRET=super_secreto_cambiar_en_produccion_123456789!
JWT_EXPIRES_IN=8h

# =====================================================
# Servidor de Correo (SMTP — Gmail, Resend, Sendgrid, etc.)
# Si se dejan vacías, se utiliza una cuenta real de pruebas en Ethereal Email automáticamente
# =====================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Commerce" <no-reply@ecommerce.com>

# =====================================================
# Auth0 — Backend (validación de tokens JWT)
# Obtener en: Auth0 Dashboard → Applications → APIs
# =====================================================
AUTH0_DOMAIN=tu-tenant.auth0.com
AUTH0_AUDIENCE=https://api.ecommerce.local

# =====================================================
# Frontend (React + Vite)
# =====================================================
VITE_API_URL=http://localhost:3000/api

# Auth0 — Frontend (SDK @auth0/auth0-react)
# Obtener en: Auth0 Dashboard → Applications → SPA
VITE_AUTH0_DOMAIN=tu-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=tu_client_id_aqui
VITE_AUTH0_AUDIENCE=https://api.ecommerce.local
